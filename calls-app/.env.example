# Copy to .env for local development. In production (DigitalOcean App
# Platform), these are set directly in the app's Environment Variables
# settings, not read from this file. This list exists specifically because
# three separate production crashes during the Render -> DO migration all
# traced back to one of these being missing or wrong, with no single place
# that documented the full required set until now.

# Supabase — required, the app crashes at startup without these.
SUPABASE_URL=
SUPABASE_KEY=

# Session/auth — required. JWT_SECRET should be a long random string.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI configured on the Google
# OAuth client, including scheme/domain/path. No trailing whitespace.
GOOGLE_CALLBACK_URL=https://calls.chumz.online/auth/google/callback
# Comma-separated emails granted supervisor role on first login.
SUPERVISOR_EMAILS=

# Legacy Africa's Talking voice fallback — optional. Missing/blank values
# only break the non-SIP-provisioned agent standby flow, not the whole app.
AT_API_KEY=
AT_USERNAME=
AT_VOICE_NUMBER=
# Base URL Africa's Talking calls back into for /voice, /agent-standby,
# /agent-standby-input — must match this app's real public domain, not a
# stale one from a previous deploy platform.
BASE_URL=https://calls.chumz.online
# Opt-in shared secret for the four unauthenticated AT webhook routes above.
# Leave unset to keep current behavior (unauthenticated, with a startup
# warning); once set, also add `&secret=<value>` to the callback URLs
# registered in the Africa's Talking dashboard for /voice and /events (the
# app adds it automatically to the URLs it generates for the other two).
AT_WEBHOOK_SECRET=

# Browser softphone (WebRTC/SIP.js) config served to agents.
SOFTPHONE_SIP_DOMAIN=sip.chumz.online
SOFTPHONE_WSS_URL=wss://sip.chumz.online:8089/ws
SOFTPHONE_TURN_URL=turn:64.227.160.38:3478
SOFTPHONE_TURN_USERNAME=chumzagent
# No default — required for TURN relay (symmetric NAT / restrictive
# firewalls) to actually work. Get this from whoever manages the TURN
# server (coturn) config.
SOFTPHONE_TURN_PASSWORD=

# Set automatically by DigitalOcean App Platform — leave unset locally to
# use the default (3000).
PORT=
