[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 5

[sshd]
enabled = true

[asterisk]
enabled  = true
backend  = auto
port     = 5060,5061,8089
logpath  = /var/log/asterisk/messages.log
           /var/log/asterisk/security
maxretry = 5

[asterisk-tls-scan]
enabled  = true
backend  = auto
port     = 8089
filter   = asterisk-tls-scan
logpath  = /var/log/asterisk/messages.log
maxretry = 6
findtime = 300
