{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // sw.ts runs in a ServiceWorkerGlobalScope, not a Window — its `self` is
  // not the DOM `self` this program's own lib config assumes, so it's
  // excluded from this program and type-checked separately via
  // tsconfig.worker.json instead (same split vite.config.ts already gets
  // via tsconfig.node.json, for the same kind of reason: a different global
  // environment than the rest of src).
  "exclude": ["src/sw.ts"],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.worker.json" }]
}
